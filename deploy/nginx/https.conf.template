server {
    listen 80;
    listen [::]:80;
    server_name alt-tyanka.ru;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://alt-tyanka.ru$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name alt-tyanka.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/alt-tyanka.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alt-tyanka.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:LauraTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location / {
        include /etc/nginx/conf.d/proxy.inc;
    }
}
